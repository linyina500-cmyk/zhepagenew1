{
  "manifest_version": 3,
  "name": "折页 · 草稿同步",
  "version": "1.0.0",
  "description": "将折页图片和配文保存到小红书或公众号草稿箱。账号资料仅在当前浏览器使用。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://creator.xiaohongshu.com/*",
    "https://api.weixin.qq.com/*"
  ],
  "background": {
    "service_worker": "browser-extension/background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "打开折页"
  },
  "externally_connectable": {
    "matches": [
      "https://feature-local-draft-sync.zhepagenew.pages.dev/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
